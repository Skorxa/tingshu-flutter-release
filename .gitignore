app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ── 项目特定:误生成目录、临时与崩溃文件 ──
# jadx/skylot 反编译工具误把当前目录当输出目录生成的
/null/
/PowerShell 7.6.3/
# eprendre 临时解包产物 (classes.dex 等)
/.tmp_sources_by_eprendre/
# 运行期崩溃 / ANR 日志
anr_*.txt
# 构建出的安装包 (双保险,/build/ 已忽略)
*.apk
*.aab
# Android 子项目构建产物 (根 /build/ 规则覆盖不到)
/android/build/
/android/app/build/
/android/.gradle/
# Claude Code 本地设置 (保留 .claude/skills 入版本)
.claude/settings.local.json
